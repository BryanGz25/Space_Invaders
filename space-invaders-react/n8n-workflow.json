{
  "name": "Space Invaders - Procesamiento de Puntaje",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "space-invaders-score",
        "options": {}
      },
      "name": "Webhook Entrante",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 1,
      "position": [100, 300]
    },
    {
      "parameters": {
        "values": {
          "string": [
            {
              "name": "mensajeEspecial",
              "value": "={{ $json.body.puntaje >= 1000 ? '¡Gran Puntuación Legendaria!' : 'Inténtalo de nuevo' }}"
            }
          ]
        }
      },
      "name": "Transformar Datos",
      "type": "n8n-nodes-base.set",
      "typeVersion": 1,
      "position": [300, 300]
    },
    {
      "parameters": {
        "conditions": {
          "number": [
            {
              "value1": "={{ $json.body.puntaje }}",
              "operation": "gte",
              "value2": 1000
            }
          ]
        }
      },
      "name": "Validar Puntaje Alto",
      "type": "n8n-nodes-base.if",
      "typeVersion": 1,
      "position": [500, 300]
    },
    {
      "parameters": {
        "options": {
          "responseCode": 200
        },
        "responseBody": "={{ { status: 'success', message: 'Puntaje Procesado', record: $json } }}"
      },
      "name": "Respuesta Al Frontend",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1,
      "position": [750, 300]
    }
  ],
  "connections": {
    "Webhook Entrante": { "main": [[{ "node": "Transformar Datos", "type": "main", "index": 0 }]] },
    "Transformar Datos": { "main": [[{ "node": "Validar Puntaje Alto", "type": "main", "index": 0 }]] },
    "Validar Puntaje Alto": { "main": [[{ "node": "Respuesta Al Frontend", "type": "main", "index": 0 }]] }
  }
}